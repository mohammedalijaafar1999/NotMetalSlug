{
  "name": "iron-ruckus",
  "private": true,
  "version": "1.0.0",
  "description": "IRON RUCKUS - an original arcade run-and-gun shooter for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
